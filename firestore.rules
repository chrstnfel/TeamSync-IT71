rules_version = '2';

// TEAMSYNC Firestore Security Rules (C6; Revised paper Sections 4.3.5 and 4.7).
// Users are identified by their login email (lower-case), which is compared
// with the email lists on the project document:
//   leaderIds = Project Manager, memberIds = students, mentorIds = Teacher.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function isManagerOf(p) {
      return me() in p.leaderIds;
    }
    function isStudentOf(p) {          // Project Manager or Project Member
      return me() in p.memberIds || me() in p.leaderIds;
    }
    function isTeacherOf(p) {
      return me() in p.mentorIds;
    }
    function inProject(p) {
      return isStudentOf(p) || isTeacherOf(p);
    }
    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function projectAfter(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    // NFR-09: the change must be committed in the same batch as its activity
    // log entry, whose ID the client stores in lastOpId.
    function logWrittenWith(projectId) {
      return existsAfter(/databases/$(database)/documents/projects/$(projectId)/activityLogs/$(request.resource.data.lastOpId));
    }
    // FR-05/FR-06: a task has a title, belongs to this project, is assigned to
    // a student of the project, and has one of the three statuses.
    function validTask(t, projectId) {
      return t.projectId == projectId
        && t.title is string && t.title.size() > 0
        && t.status in ['To Do', 'In Progress', 'Done']
        && (t.assignedTo in projectData(projectId).memberIds
            || t.assignedTo in projectData(projectId).leaderIds);
    }

    // ---------- users/{uid} (M1) ----------
    // Any signed-in user can read profiles (needed to show teammates' names and
    // to invite by email); a user can only write their own profile.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == me();
      allow delete: if false;
    }

    // ---------- projects/{projectId} (M2) ----------
    match /projects/{projectId} {
      // FR-14: users only see projects they belong to.
      allow read: if signedIn() && inProject(resource.data);

      // T2: the creator becomes the only Project Manager.
      allow create: if signedIn()
        && request.resource.data.projectId == projectId
        && request.resource.data.creatorId == me()
        && request.resource.data.leaderIds == [me()]
        && me() in request.resource.data.memberIds
        && logWrittenWith(projectId);

      // Edit details, invite members/teachers, change leaders (Project Manager only).
      allow update: if signedIn()
        && isManagerOf(resource.data)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.lastOpId != resource.data.get('lastOpId', '')
        && logWrittenWith(projectId);

      allow delete: if signedIn() && isManagerOf(resource.data);

      // ---------- activityLogs (M8) ----------
      // Read by the Project Manager and the Teacher. Never edited or deleted.
      match /activityLogs/{logId} {
        allow read: if signedIn()
          && (isManagerOf(projectData(projectId)) || isTeacherOf(projectData(projectId)));
        allow create: if signedIn()
          && inProject(projectAfter(projectId))
          && request.resource.data.logId == logId
          && request.resource.data.projectId == projectId
          && request.resource.data.actorId == me()
          && request.resource.data.timestamp == request.time;
        allow update, delete: if false;
      }

      // ---------- tasks (M3) ----------
      // Everyone in the project can read tasks (task list, member progress,
      // teacher overview). Only the Project Manager creates, edits, marks
      // status and deletes (FR-05, FR-06, NFR-07). Every write is logged.
      match /tasks/{taskId} {
        allow read: if signedIn() && inProject(projectData(projectId));

        allow create: if signedIn()
          && isManagerOf(projectData(projectId))
          && validTask(request.resource.data, projectId)
          && request.resource.data.taskId == taskId
          && request.resource.data.status == 'To Do'
          && request.resource.data.createdBy == me()
          && logWrittenWith(projectId);

        allow update: if signedIn()
          && isManagerOf(projectData(projectId))
          && validTask(request.resource.data, projectId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.lastOpId != resource.data.get('lastOpId', '')
          && logWrittenWith(projectId);

        allow delete: if signedIn() && isManagerOf(projectData(projectId));
      }

      // ---------- messages (M4 Project Chat, FR-08) ----------
      // Project Manager and Project Members only (Section 4.7 access table).
      // A message is sent as yourself, with server time, and is logged.
      match /messages/{messageId} {
        allow read: if signedIn() && isStudentOf(projectData(projectId));
        allow create: if signedIn()
          && isStudentOf(projectData(projectId))
          && request.resource.data.messageId == messageId
          && request.resource.data.projectId == projectId
          && request.resource.data.senderId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time
          && logWrittenWith(projectId);
        allow update, delete: if false;
      }

      // ---------- comments (M7 Teacher Monitoring, FR-11) ----------
      // Read by everyone in the project (shown to members, UC-11).
      // Only an invited Teacher posts, as themselves, with server time, logged.
      match /comments/{commentId} {
        allow read: if signedIn() && inProject(projectData(projectId));
        allow create: if signedIn()
          && isTeacherOf(projectData(projectId))
          && request.resource.data.commentId == commentId
          && request.resource.data.projectId == projectId
          && request.resource.data.teacherId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && logWrittenWith(projectId);
        allow update, delete: if false;
      }

      // ---------- notes (extra feature kept from the 3rd-year app) ----------
      match /notes/{noteId} {
        allow read, write: if signedIn() && isStudentOf(projectData(projectId));
      }
    }

    // ---------- LEGACY top-level collection ----------
    // Used by the current FilesFragment until files move to
    // projects/{id}/files in increment (c). Remove this block then.
    match /files/{fileId} {
      allow read: if signedIn() && inProject(projectData(resource.data.projectId));
      allow create: if signedIn() && isStudentOf(projectData(request.resource.data.projectId));
      allow update, delete: if false;
    }
  }
}
